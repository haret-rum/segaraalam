@book{angusWarCommonsDispossession2023,
  title = {The War against the Commons: Dispossession and Resistance in the Making of Capitalism},
  shorttitle = {The War against the Commons},
  author = {Angus, Ian},
  year = 2023,
  publisher = {Monthly Review Press},
  address = {New York},
  abstract = {"For five centuries, the development of capitalism has been inextricably connected to the expropriation of working people from the land they depended on for subsistence. Through ruling class assaults known as enclosures or clearances, shared common land became privately-owned capital, and peasant farmers became propertyless laborers who could only survive by working for the owners of land or capital. As Ian Angus documents in The War Against the Commons, mass opposition to dispossession has never ceased. His dramatic account provides new insights into an opposition that ranged from stubborn non-compliance to open rebellion, including eyewitness accounts of campaigns in which thousands of protestors tore down fences and restored common access to pastures and forests. Contrary to many accounts that treat the reorganization of agriculture as a purely domestic matter, Angus shows that there were close connections between the enclosures in Britain and imperial expansion"--},
  isbn = {978-1-68590-016-8 978-1-68590-018-2 978-1-68590-019-9},
  langid = {english},
