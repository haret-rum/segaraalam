@article{aminiAllegoriesReasonEurocentrism2010,
  title = {Allegories of {{Reason}}: {{Eurocentrism}} and {{Native Philosophical Resistance}}},
  shorttitle = {Allegories of {{Reason}}},
  author = {Amini, Majid},
  year = 2010,
  month = apr,
  journal = {Culture, Theory and Critique},
  volume = {51},
  number = {1},
  pages = {29--45},
  issn = {1473-5784, 1473-5776},
  doi = {10.1080/14735781003795117},
  urldate = {2025-09-09},
  abstract = {Eurocentrism' is claimed to epitomize a certain philosophical worldview and, in particular, to propagate an exhaustive as well as exclusive conception of `reason' and thus by extension of `philosophy'. Philosophical Eurocentrism is seen as a hegemonic attempt to suppress other philosophical percepts and precepts and subsume all other perspectives into one vast, boundless mass: that is, a homogenization and effacement of difference that would ultimately culminate in the philosophical annihilation of `the other'. Accordingly, anti-Eurocentric intellectuals have been motivated to reclaim reason and philosophy from the philosophical imperialism of Eurocentrism and thereby to advance the cause of philosophical regionalism. This proclivity for philosophical provincialism has been most pronounced in the attempts to forge `native' philosophical systems of thought and ideas. The purpose of this paper is, therefore, to examine the following questions: (1) what is Eurocentric reason or philosophy?, and (2) can reason or philosophy be contextualized in terms of continental contours and cultural confines? To give a concrete base to the discussion, the questions are examined in the context of the recent attempts by Caribbean thinkers to construct national and regional philosophical edifices.},
  langid = {english},
  file = {E:\Syncthing\Obsidian\PDF-Zotero\Proyek Dekolonial\Eurosentrisme Filsafat\Amini - 2010 - Allegories of Reason Eurocentrism and Native Philosophical Resistance.pdf}
}

