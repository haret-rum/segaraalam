  author = {Roswantoro, Alim},
  abstract = {The writing tries to explore the theologically islamic ideas of ecology and then philosophically reflects it in order to disclose the fundamental significance. This effort is encouraged by some phenomena of natural damages which increasingly extend causing the global warming and climate change threatening the life of the earth. Islamic theology of environment and its protection is conceptualized through theological sources of Islam, i.e., the verses of the Qur'an and the tradition, and then the writer tries to find out its meaning and completes it with some interpretations of muslim thinkers concerning it. After obtaining the meaningful understanding of islamic ecology, finally the article intends to reflect or contemplate it philosophically. The result of the reflection or the contemplation is that islamic ecology is not merely natural ecology, but also religious ecology which is the substance is the theomorphic nature of the human existence.},
  langid = {indonesian},
