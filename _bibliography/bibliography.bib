}

@article{abdillahDEKONSTRUKSITAFSIRANTROPOSENTRISME2014,
  title = {{DEKONSTRUKSI TAFSIR ANTROPOSENTRISME: Telaah Ayat-Ayat Berwawasan Lingkungan}},
  shorttitle = {{DEKONSTRUKSI TAFSIR ANTROPOSENTRISME}},
