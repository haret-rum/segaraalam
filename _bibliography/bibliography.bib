  author = {{Di-Capua}, Yoav},
  year = 2013,
  journal = {Journal of Arabic Literature},
  volume = {44},
  number = {1},
  pages = {21--52},
  issn = {0085-2376, 1570-064X},
  doi = {10.1163/1570064x-12341255},
  urldate = {2026-02-10},
  abstract = {\d H usayn Muruwwah was one of the most inluential Arab intellectuals of the second half of the twentieth century. In the 1950s and 1960s he was critical in reinventing literary criticism and was at the vanguard of the postcolonial intelligentsia and its search for a new Arab culture. Before that he was cleric at Najaf, then a follower of Arab Liberalism, then a Marxist and, eventually a Communist. In the process of this intellectual metamorphosis Muruwwah moved from South Lebanon, to Najaf, Baghdad, Beirut, Damascus and Moscow. his article reconsiders the importance of Muruwwah's personal narrative of displacement, search and commitment to Arab postcoloniality. It argues that much of what has been written about \d H usayn Muruwwah's life underscores a polarization of experience---as movement from the village to the city, from religion to secularism, from Liberalism to Communism. In contrast, this article suggests that \d H usayn Muruwwah, and dozens of others like him, never really shifted between positions, or ``converted.'' Instead, Muruwwah kept adding layer after layer to what became a complex and highly integrative intellectual identity that simultaneously drew on several seemingly contradictory traditions and intellectual genealogies, culminating in his methodology of critical Socialist Realism and the efort to re-read Islamic tur\=ath along Marxist lines.},
  langid = {english},
  file = {E:\Syncthing\Obsidian\PDF-Zotero\Turats Arab Islam\Artikel Muruwwah\Di-Capua - 2013 - Homeward Bound Ḥusayn Muruwwah’s Integrative Quest for Authenticity.pdf}
